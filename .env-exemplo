# ============================================================
# CONFIGURAÇÃO DO AZURE DEVOPS WORKER
# ============================================================
# Copie este arquivo para .env e preencha com suas informações
# COMANDO: cp .env-exemplo .env
# ============================================================

# ----------------------------------------------------------
# 1. ORGANIZAÇÃO DO AZURE DEVOPS (AZURE_DEVOPS_ORG)
# ----------------------------------------------------------
# Como encontrar:
# - Acesse o Azure DevOps no navegador
# - Olhe a URL: https://dev.azure.com/NOME-DA-ORG/projeto/...
# - O nome após "dev.azure.com/" é sua organização
#
# Exemplo: https://dev.azure.com/Trizy/Squad%20Varejo/...
#          Organização = Trizy
#
AZURE_DEVOPS_ORG=Trizy

# ----------------------------------------------------------
# 2. NOME DO PROJETO (AZURE_DEVOPS_PROJECT)
# ----------------------------------------------------------
# Como encontrar:
# - Na mesma URL, após o nome da organização
# - Ou no canto superior esquerdo quando estiver no projeto
#
# Exemplo: https://dev.azure.com/Trizy/Squad%20Varejo/...
#          Projeto = Squad Varejo
#
# IMPORTANTE: Se o nome tiver espaços, use o nome real (sem %20)
#
AZURE_DEVOPS_PROJECT=Squad Varejo

# ----------------------------------------------------------
# 3. PERSONAL ACCESS TOKEN - PAT (AZURE_DEVOPS_PAT)
# ----------------------------------------------------------
# Como criar:
# 1. Acesse: https://dev.azure.com/sua-organizacao
# 2. Clique na sua foto/avatar (canto superior direito)
# 3. Selecione "Personal access tokens"
# 4. Clique em "+ New Token"
# 5. Preencha:
#    - Name: Worker Automation (ou qualquer nome)
#    - Organization: All accessible organizations (ou selecione)
#    - Expiration: 90 days (ou o período desejado)
# 6. Em "Scopes", configure as permissões:
#    - Work Items: Read & write (OBRIGATÓRIO para atualizar cards)
#    - (Opcional) Build: Read & execute
#    - (Opcional) Code: Read
# 7. Clique em "Create"
# 8. COPIE O TOKEN IMEDIATAMENTE! Ele só aparece uma vez!
#
# IMPORTANTE: O token deve ter permissão "Read & write" em Work Items
#             Caso contrário, o worker não conseguirá atualizar os cards
#
AZURE_DEVOPS_PAT=cole-seu-token-aqui

# ----------------------------------------------------------
# 4. ID DO EPIC ALVO (TARGET_EPIC_ID)
# ----------------------------------------------------------
# Como encontrar:
# - Abra o Epic no Azure DevOps
# - Olhe a URL: .../_workitems/edit/NUMERO/
# - O número final é o ID do Epic
#
# Exemplo: https://dev.azure.com/Trizy/Squad%20Varejo/_workitems/edit/105346/
#          Epic ID = 105346
#
# DICA: Você também pode ver o ID no canto superior esquerdo
#       do card quando ele está aberto
#
TARGET_EPIC_ID=105346

# ----------------------------------------------------------
# 5. PASTA DE SAÍDA DOS ARQUIVOS (OUTPUT_DIR)
# ----------------------------------------------------------
# Pasta local onde os arquivos .md serão gerados
# Use caminho relativo (./pasta) ou absoluto (/caminho/completo)
#
# Exemplos:
#   ./generated_task_codes  (pasta no diretório atual)
#   ./task_codes            (nome mais curto)
#   /tmp/azure-tasks        (caminho absoluto)
#
# A pasta será criada automaticamente se não existir
#
OUTPUT_DIR=./generated_task_codes

# ============================================================
# DICAS DE SEGURANÇA
# ============================================================
# 1. NUNCA commit o arquivo .env no Git!
#    - Adicione ".env" no seu .gitignore
# 2. Mantenha o .env-exemplo no repositório (sem dados reais)
# 3. Renove o PAT regularmente (a cada 90 dias é recomendado)
# 4. Se o token vazar, revogue-o imediatamente no Azure DevOps
# ============================================================